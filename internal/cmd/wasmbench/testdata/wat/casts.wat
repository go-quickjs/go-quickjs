;; GC casts: objects of a chain of struct types 41 deep and of a branch off
;; it tested, cast and branched on against types at depths from 0 to 40 --
;; ref.test, ref.cast and br_on_cast and br_on_cast_fail -- each test
;; answered by the object's type's supertype at the target's depth.
(module
  (type $t0 (sub (struct (field (mut i32)))))
  (type $t1 (sub $t0 (struct (field (mut i32)))))
  (type $t2 (sub $t1 (struct (field (mut i32)))))
  (type $t3 (sub $t2 (struct (field (mut i32)))))
  (type $t4 (sub $t3 (struct (field (mut i32)))))
  (type $t5 (sub $t4 (struct (field (mut i32)))))
  (type $t6 (sub $t5 (struct (field (mut i32)))))
  (type $t7 (sub $t6 (struct (field (mut i32)))))
  (type $t8 (sub $t7 (struct (field (mut i32)))))
  (type $t9 (sub $t8 (struct (field (mut i32)))))
  (type $t10 (sub $t9 (struct (field (mut i32)))))
  (type $t11 (sub $t10 (struct (field (mut i32)))))
  (type $t12 (sub $t11 (struct (field (mut i32)))))
  (type $t13 (sub $t12 (struct (field (mut i32)))))
  (type $t14 (sub $t13 (struct (field (mut i32)))))
  (type $t15 (sub $t14 (struct (field (mut i32)))))
  (type $t16 (sub $t15 (struct (field (mut i32)))))
  (type $t17 (sub $t16 (struct (field (mut i32)))))
  (type $t18 (sub $t17 (struct (field (mut i32)))))
  (type $t19 (sub $t18 (struct (field (mut i32)))))
  (type $t20 (sub $t19 (struct (field (mut i32)))))
  (type $t21 (sub $t20 (struct (field (mut i32)))))
  (type $t22 (sub $t21 (struct (field (mut i32)))))
  (type $t23 (sub $t22 (struct (field (mut i32)))))
  (type $t24 (sub $t23 (struct (field (mut i32)))))
  (type $t25 (sub $t24 (struct (field (mut i32)))))
  (type $t26 (sub $t25 (struct (field (mut i32)))))
  (type $t27 (sub $t26 (struct (field (mut i32)))))
  (type $t28 (sub $t27 (struct (field (mut i32)))))
  (type $t29 (sub $t28 (struct (field (mut i32)))))
  (type $t30 (sub $t29 (struct (field (mut i32)))))
  (type $t31 (sub $t30 (struct (field (mut i32)))))
  (type $t32 (sub $t31 (struct (field (mut i32)))))
  (type $t33 (sub $t32 (struct (field (mut i32)))))
  (type $t34 (sub $t33 (struct (field (mut i32)))))
  (type $t35 (sub $t34 (struct (field (mut i32)))))
  (type $t36 (sub $t35 (struct (field (mut i32)))))
  (type $t37 (sub $t36 (struct (field (mut i32)))))
  (type $t38 (sub $t37 (struct (field (mut i32)))))
  (type $t39 (sub $t38 (struct (field (mut i32)))))
  (type $t40 (sub $t39 (struct (field (mut i32)))))
  (type $u10 (sub $t9 (struct (field (mut i32)))))
  (type $u11 (sub $u10 (struct (field (mut i32)))))
  (type $u12 (sub $u11 (struct (field (mut i32)))))
  (type $u13 (sub $u12 (struct (field (mut i32)))))
  (type $u14 (sub $u13 (struct (field (mut i32)))))
  (type $u15 (sub $u14 (struct (field (mut i32)))))
  (type $u16 (sub $u15 (struct (field (mut i32)))))
  (type $u17 (sub $u16 (struct (field (mut i32)))))
  (type $u18 (sub $u17 (struct (field (mut i32)))))
  (type $u19 (sub $u18 (struct (field (mut i32)))))
  (type $u20 (sub $u19 (struct (field (mut i32)))))
  (type $objs (array (ref $t0)))

  (func (export "run") (param $n i32) (result i64)
    (local $a (ref $objs)) (local $o (ref $t0)) (local $i i32) (local $s i64)
    (local $d10 (ref $t10)) (local $d0 (ref $t0))
    (local.set $a (array.new_fixed $objs 8
      (struct.new $t3 (i32.const 3)) (struct.new $t10 (i32.const 10))
      (struct.new $t20 (i32.const 20)) (struct.new $t40 (i32.const 40))
      (struct.new $u11 (i32.const 11)) (struct.new $u20 (i32.const 20))
      (struct.new $t0 (i32.const 0)) (struct.new $t39 (i32.const 39))))
    (local.set $d10 (struct.new $t10 (i32.const 100)))
    (local.set $d0 (struct.new $t0 (i32.const 1000)))
    (loop $l
      (local.set $o (array.get $objs (local.get $a) (i32.and (local.get $i) (i32.const 7))))
      (local.set $s (i64.add (local.get $s) (i64.extend_i32_u (i32.add
        (i32.add (ref.test (ref $t3) (local.get $o)) (i32.shl (ref.test (ref $t20) (local.get $o)) (i32.const 1)))
        (i32.add (i32.shl (ref.test (ref $t40) (local.get $o)) (i32.const 2))
                 (i32.shl (ref.test (ref $u15) (local.get $o)) (i32.const 3)))))))
      (local.set $s (i64.add (local.get $s)
        (i64.extend_i32_u (struct.get $t0 0 (ref.cast (ref $t0) (local.get $o))))))
      (local.set $s (i64.add (local.get $s) (i64.extend_i32_u
        (struct.get $t10 0
          (block $yes (result (ref $t10))
            (drop (br_on_cast $yes (ref $t0) (ref $t10) (local.get $o)))
            (local.get $d10))))))
      (local.set $s (i64.add (local.get $s) (i64.extend_i32_u
        (struct.get $t0 0
          (block $no (result (ref $t0))
            (drop (br_on_cast_fail $no (ref $t0) (ref $u12) (local.get $o)))
            (local.get $d0))))))
      (local.set $s (i64.rotl (local.get $s) (i64.const 1)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $s)))
