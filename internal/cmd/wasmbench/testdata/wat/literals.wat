;; GC arrays a compiled GC language makes from constants: strings of i8s
;; and tables of i32s from a data segment (array.new_data), arrays of i31s
;; from an element segment (array.new_elem), a long literal array of i32s
;; and one of references (array.new_fixed past what a short array holds),
;; and arrays of v128s (array.new_default, array.new_fixed and array.new),
;; each read back into a checksum.
(module
  (type $bytes (array (mut i8)))
  (type $i32s (array (mut i32)))
  (type $refs (array (mut (ref null eq))))
  (type $vecs (array (mut v128)))

  (data $text "The quick brown fox jumps over the lazy dog; pack my box with five dozen liquor jugs.")
  (data $table "\01\00\00\00\02\00\00\00\03\00\00\00\05\00\00\00\08\00\00\00\0d\00\00\00\15\00\00\00\22\00\00\00\37\00\00\00\59\00\00\00\90\00\00\00\e9\00\00\00")
  (elem $smalls (ref i31)
    (item (ref.i31 (i32.const 3))) (item (ref.i31 (i32.const 1))) (item (ref.i31 (i32.const 4)))
    (item (ref.i31 (i32.const 1))) (item (ref.i31 (i32.const 5))) (item (ref.i31 (i32.const 9)))
    (item (ref.i31 (i32.const 2))) (item (ref.i31 (i32.const 6))) (item (ref.i31 (i32.const 5))))

  ;; A string of 4 to 19 bytes of the text, hashed.
  (func $str (param $i i32) (result i32)
    (local $s (ref $bytes)) (local $h i32) (local $k i32)
    (local.set $s
      (array.new_data $bytes $text (i32.and (local.get $i) (i32.const 63))
        (i32.add (i32.and (local.get $i) (i32.const 15)) (i32.const 4))))
    (loop $l
      (local.set $h
        (i32.add (i32.mul (local.get $h) (i32.const 31)) (array.get_u $bytes (local.get $s) (local.get $k))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $k) (array.len (local.get $s)))))
    (local.get $h))

  ;; Four i32s of the table and four i31s of the element segment.
  (func $tables (param $i i32) (result i32)
    (local $t (ref $i32s)) (local $e (ref $refs))
    (local.set $t (array.new_data $i32s $table (i32.shl (i32.and (local.get $i) (i32.const 7)) (i32.const 2)) (i32.const 4)))
    (local.set $e (array.new_elem $refs $smalls (i32.and (local.get $i) (i32.const 3)) (i32.const 4)))
    (i32.add
      (i32.add (array.get $i32s (local.get $t) (i32.const 0)) (array.get $i32s (local.get $t) (i32.const 3)))
      (i32.add
        (i31.get_u (ref.cast (ref i31) (array.get $refs (local.get $e) (i32.const 0))))
        (i31.get_u (ref.cast (ref i31) (array.get $refs (local.get $e) (i32.const 3)))))))

  ;; A literal array of 128 i32s and one of 36 references, past what the
  ;; short arrays' blocks hold.
  (func $literals (param $i i32) (result i32)
    (local $a (ref $i32s)) (local $r (ref $refs))
    (local.set $a
      (array.new_fixed $i32s 128
          (i32.add (local.get $i) (i32.const 0))
          (i32.add (local.get $i) (i32.const 1))
          (i32.add (local.get $i) (i32.const 2))
          (i32.add (local.get $i) (i32.const 3))
          (i32.add (local.get $i) (i32.const 4))
          (i32.add (local.get $i) (i32.const 5))
          (i32.add (local.get $i) (i32.const 6))
          (i32.add (local.get $i) (i32.const 7))
          (i32.add (local.get $i) (i32.const 8))
          (i32.add (local.get $i) (i32.const 9))
          (i32.add (local.get $i) (i32.const 10))
          (i32.add (local.get $i) (i32.const 11))
          (i32.add (local.get $i) (i32.const 12))
          (i32.add (local.get $i) (i32.const 13))
          (i32.add (local.get $i) (i32.const 14))
          (i32.add (local.get $i) (i32.const 15))
          (i32.add (local.get $i) (i32.const 16))
          (i32.add (local.get $i) (i32.const 17))
          (i32.add (local.get $i) (i32.const 18))
          (i32.add (local.get $i) (i32.const 19))
          (i32.add (local.get $i) (i32.const 20))
          (i32.add (local.get $i) (i32.const 21))
          (i32.add (local.get $i) (i32.const 22))
          (i32.add (local.get $i) (i32.const 23))
          (i32.add (local.get $i) (i32.const 24))
          (i32.add (local.get $i) (i32.const 25))
          (i32.add (local.get $i) (i32.const 26))
          (i32.add (local.get $i) (i32.const 27))
          (i32.add (local.get $i) (i32.const 28))
          (i32.add (local.get $i) (i32.const 29))
          (i32.add (local.get $i) (i32.const 30))
          (i32.add (local.get $i) (i32.const 31))
          (i32.add (local.get $i) (i32.const 32))
          (i32.add (local.get $i) (i32.const 33))
          (i32.add (local.get $i) (i32.const 34))
          (i32.add (local.get $i) (i32.const 35))
          (i32.add (local.get $i) (i32.const 36))
          (i32.add (local.get $i) (i32.const 37))
          (i32.add (local.get $i) (i32.const 38))
          (i32.add (local.get $i) (i32.const 39))
          (i32.add (local.get $i) (i32.const 40))
          (i32.add (local.get $i) (i32.const 41))
          (i32.add (local.get $i) (i32.const 42))
          (i32.add (local.get $i) (i32.const 43))
          (i32.add (local.get $i) (i32.const 44))
          (i32.add (local.get $i) (i32.const 45))
          (i32.add (local.get $i) (i32.const 46))
          (i32.add (local.get $i) (i32.const 47))
          (i32.add (local.get $i) (i32.const 48))
          (i32.add (local.get $i) (i32.const 49))
          (i32.add (local.get $i) (i32.const 50))
          (i32.add (local.get $i) (i32.const 51))
          (i32.add (local.get $i) (i32.const 52))
          (i32.add (local.get $i) (i32.const 53))
          (i32.add (local.get $i) (i32.const 54))
          (i32.add (local.get $i) (i32.const 55))
          (i32.add (local.get $i) (i32.const 56))
          (i32.add (local.get $i) (i32.const 57))
          (i32.add (local.get $i) (i32.const 58))
          (i32.add (local.get $i) (i32.const 59))
          (i32.add (local.get $i) (i32.const 60))
          (i32.add (local.get $i) (i32.const 61))
          (i32.add (local.get $i) (i32.const 62))
          (i32.add (local.get $i) (i32.const 63))
          (i32.add (local.get $i) (i32.const 64))
          (i32.add (local.get $i) (i32.const 65))
          (i32.add (local.get $i) (i32.const 66))
          (i32.add (local.get $i) (i32.const 67))
          (i32.add (local.get $i) (i32.const 68))
          (i32.add (local.get $i) (i32.const 69))
          (i32.add (local.get $i) (i32.const 70))
          (i32.add (local.get $i) (i32.const 71))
          (i32.add (local.get $i) (i32.const 72))
          (i32.add (local.get $i) (i32.const 73))
          (i32.add (local.get $i) (i32.const 74))
          (i32.add (local.get $i) (i32.const 75))
          (i32.add (local.get $i) (i32.const 76))
          (i32.add (local.get $i) (i32.const 77))
          (i32.add (local.get $i) (i32.const 78))
          (i32.add (local.get $i) (i32.const 79))
          (i32.add (local.get $i) (i32.const 80))
          (i32.add (local.get $i) (i32.const 81))
          (i32.add (local.get $i) (i32.const 82))
          (i32.add (local.get $i) (i32.const 83))
          (i32.add (local.get $i) (i32.const 84))
          (i32.add (local.get $i) (i32.const 85))
          (i32.add (local.get $i) (i32.const 86))
          (i32.add (local.get $i) (i32.const 87))
          (i32.add (local.get $i) (i32.const 88))
          (i32.add (local.get $i) (i32.const 89))
          (i32.add (local.get $i) (i32.const 90))
          (i32.add (local.get $i) (i32.const 91))
          (i32.add (local.get $i) (i32.const 92))
          (i32.add (local.get $i) (i32.const 93))
          (i32.add (local.get $i) (i32.const 94))
          (i32.add (local.get $i) (i32.const 95))
          (i32.add (local.get $i) (i32.const 96))
          (i32.add (local.get $i) (i32.const 97))
          (i32.add (local.get $i) (i32.const 98))
          (i32.add (local.get $i) (i32.const 99))
          (i32.add (local.get $i) (i32.const 100))
          (i32.add (local.get $i) (i32.const 101))
          (i32.add (local.get $i) (i32.const 102))
          (i32.add (local.get $i) (i32.const 103))
          (i32.add (local.get $i) (i32.const 104))
          (i32.add (local.get $i) (i32.const 105))
          (i32.add (local.get $i) (i32.const 106))
          (i32.add (local.get $i) (i32.const 107))
          (i32.add (local.get $i) (i32.const 108))
          (i32.add (local.get $i) (i32.const 109))
          (i32.add (local.get $i) (i32.const 110))
          (i32.add (local.get $i) (i32.const 111))
          (i32.add (local.get $i) (i32.const 112))
          (i32.add (local.get $i) (i32.const 113))
          (i32.add (local.get $i) (i32.const 114))
          (i32.add (local.get $i) (i32.const 115))
          (i32.add (local.get $i) (i32.const 116))
          (i32.add (local.get $i) (i32.const 117))
          (i32.add (local.get $i) (i32.const 118))
          (i32.add (local.get $i) (i32.const 119))
          (i32.add (local.get $i) (i32.const 120))
          (i32.add (local.get $i) (i32.const 121))
          (i32.add (local.get $i) (i32.const 122))
          (i32.add (local.get $i) (i32.const 123))
          (i32.add (local.get $i) (i32.const 124))
          (i32.add (local.get $i) (i32.const 125))
          (i32.add (local.get $i) (i32.const 126))
          (i32.add (local.get $i) (i32.const 127))))
    (local.set $r
      (array.new_fixed $refs 36
          (ref.i31 (i32.add (local.get $i) (i32.const 0)))
          (ref.i31 (i32.add (local.get $i) (i32.const 1)))
          (ref.i31 (i32.add (local.get $i) (i32.const 2)))
          (ref.i31 (i32.add (local.get $i) (i32.const 3)))
          (ref.i31 (i32.add (local.get $i) (i32.const 4)))
          (ref.i31 (i32.add (local.get $i) (i32.const 5)))
          (ref.i31 (i32.add (local.get $i) (i32.const 6)))
          (ref.i31 (i32.add (local.get $i) (i32.const 7)))
          (ref.i31 (i32.add (local.get $i) (i32.const 8)))
          (ref.i31 (i32.add (local.get $i) (i32.const 9)))
          (ref.i31 (i32.add (local.get $i) (i32.const 10)))
          (ref.i31 (i32.add (local.get $i) (i32.const 11)))
          (ref.i31 (i32.add (local.get $i) (i32.const 12)))
          (ref.i31 (i32.add (local.get $i) (i32.const 13)))
          (ref.i31 (i32.add (local.get $i) (i32.const 14)))
          (ref.i31 (i32.add (local.get $i) (i32.const 15)))
          (ref.i31 (i32.add (local.get $i) (i32.const 16)))
          (ref.i31 (i32.add (local.get $i) (i32.const 17)))
          (ref.i31 (i32.add (local.get $i) (i32.const 18)))
          (ref.i31 (i32.add (local.get $i) (i32.const 19)))
          (ref.i31 (i32.add (local.get $i) (i32.const 20)))
          (ref.i31 (i32.add (local.get $i) (i32.const 21)))
          (ref.i31 (i32.add (local.get $i) (i32.const 22)))
          (ref.i31 (i32.add (local.get $i) (i32.const 23)))
          (ref.i31 (i32.add (local.get $i) (i32.const 24)))
          (ref.i31 (i32.add (local.get $i) (i32.const 25)))
          (ref.i31 (i32.add (local.get $i) (i32.const 26)))
          (ref.i31 (i32.add (local.get $i) (i32.const 27)))
          (ref.i31 (i32.add (local.get $i) (i32.const 28)))
          (ref.i31 (i32.add (local.get $i) (i32.const 29)))
          (ref.i31 (i32.add (local.get $i) (i32.const 30)))
          (ref.i31 (i32.add (local.get $i) (i32.const 31)))
          (ref.i31 (i32.add (local.get $i) (i32.const 32)))
          (ref.i31 (i32.add (local.get $i) (i32.const 33)))
          (ref.i31 (i32.add (local.get $i) (i32.const 34)))
          (ref.i31 (i32.add (local.get $i) (i32.const 35)))))
    (i32.add (array.get $i32s (local.get $a) (i32.and (local.get $i) (i32.const 127)))
      (i31.get_u (ref.cast (ref i31) (array.get $refs (local.get $r) (i32.const 35))))))

  ;; Arrays of v128s: four zero, two literal and three of one value.
  (func $vectors (param $i i32) (result i32)
    (local $z (ref $vecs)) (local $f (ref $vecs)) (local $n (ref $vecs))
    (local.set $z (array.new_default $vecs (i32.const 4)))
    (array.set $vecs (local.get $z) (i32.const 1) (i32x4.splat (local.get $i)))
    (local.set $f (array.new_fixed $vecs 2 (i32x4.splat (local.get $i)) (i64x2.splat (i64.const 7))))
    (local.set $n (array.new $vecs (array.get $vecs (local.get $f) (i32.const 0)) (i32.const 3)))
    (i32x4.extract_lane 0
      (i32x4.add
        (i32x4.add (array.get $vecs (local.get $z) (i32.const 1)) (array.get $vecs (local.get $f) (i32.const 1)))
        (array.get $vecs (local.get $n) (i32.const 2)))))

  (func (export "run") (param $n i32) (result i64)
    (local $i i32) (local $acc i64)
    (loop $l
      (local.set $acc
        (i64.add (i64.mul (local.get $acc) (i64.const 31))
          (i64.extend_i32_u
            (i32.add
              (i32.add (call $str (local.get $i)) (call $tables (local.get $i)))
              (i32.add (call $literals (local.get $i)) (call $vectors (local.get $i)))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $acc)))
